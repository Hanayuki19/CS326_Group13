#Please create an .env file first, and follow the instruction

#These are two expected secrets and configs needed to run this app

#Mongo login (replace username, password, host, port, and database as needed) in your .env configs
#(Example) Default login for Gantry environment
MONGODB_URI = "mongodb://USERNAME:PASSWORD@mongo:PORT/DATABASE?authSource=admin"

#Initialize SESSION_SECRET with a random string into .env before starting the application
SESSION_SECRET = "your-session-key"

#Create Admin account password (for more details credentials, please change admin config defaults in credentials.json and student.json)
Admin_password = "Your-Password-Here"

#Create Student account password (for more details credentials, please change student config defaults in credentials.json and student.json)
Student_password = "Your-Password-Here"
