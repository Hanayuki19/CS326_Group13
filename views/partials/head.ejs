<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= typeof title !== 'undefined' ? title : 'CS326 Group 13' %></title>
<link rel="stylesheet" href="/style.css" />
<%# By default htmx throws 4xx/5xx responses away. This sends their body to
    the #status live region instead, so errors are announced like successes. %>
<meta
  name="htmx-config"
  content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true,"target":"#status","swapOverride":"innerHTML"},{"code":"...","swap":false}]}'
/>
<script src="https://unpkg.com/htmx.org@2.0.4"></script>
<script src="/focus.js" defer></script>
