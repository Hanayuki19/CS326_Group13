<li
  id="student-<%= entry.id %>"
  class="flex flex-col gap-2 rounded border border-stone-200 bg-white p-3 sm:flex-row sm:items-center"
  data-id="<%= entry.id %>"
  data-title="<%= entry.name %>"
  data-body="<%= entry.major %>"
>
  <a
    class="text-sm font-medium text-maroon hover:underline"
    href="/students/student/<%= entry.id %>"
    aria-label="View <%= entry.name %>"
    >View</a
  >
  <span class="entry-display flex-1 text-sm"
    ><strong><%= entry.name %>:</strong> <%= entry.major %></span
  >
  <%# data-focus-after: where focus.js sends focus once this button has been
      swapped out of the page. %>
  <button
    id="edit-<%= entry.id %>"
    class="edit-btn rounded border border-maroon px-3 py-1 text-sm text-maroon hover:bg-maroon hover:text-white disabled:opacity-50"
    type="button"
    aria-label="Edit <%= entry.name %>"
    hx-get="/students/<%= entry.id %>/edit"
    hx-target="closest li"
    hx-swap="outerHTML"
    data-focus-after="edit-name-<%= entry.id %>"
  >
    Edit
  </button>
  <button
    id="delete-<%= entry.id %>"
    class="delete-btn rounded border border-red-700 px-3 py-1 text-sm text-red-700 hover:bg-red-700 hover:text-white disabled:opacity-50"
    type="button"
    aria-label="Delete <%= entry.name %>"
    hx-delete="/students/<%= entry.id %>"
    hx-target="closest li"
    hx-swap="outerHTML"
  >
    Delete
  </button>
</li>
<% if (locals.status) { %><%- include('status_oob', { status }) %><% } %>
