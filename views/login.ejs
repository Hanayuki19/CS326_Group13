<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body class="min-h-screen bg-stone-50 font-sans text-stone-900 antialiased">
    <main class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
      <%- include('partials/header_auth') %>
      <h1 id="welcome" class="mb-6 text-2xl font-bold tracking-tight text-maroon sm:text-3xl">Login</h1>
      <form id="login-form" class="mb-6 flex w-full max-w-sm flex-col gap-3">
        <input class="rounded border border-stone-300 bg-white px-3 py-2 text-sm focus:border-maroon focus:ring-2 focus:ring-maroon/30 focus:outline-none" type="text" name="Username" placeholder="Username">
        <input class="rounded border border-stone-300 bg-white px-3 py-2 text-sm focus:border-maroon focus:ring-2 focus:ring-maroon/30 focus:outline-none" type="password" name="Password" placeholder="Password">
        <button class="rounded bg-maroon px-4 py-2 text-sm font-semibold text-white hover:bg-maroon-dark disabled:opacity-50" type="submit">Login</button>
      </form>
      <p class="text-sm text-stone-600">Don't have an account? <a class="font-medium text-maroon hover:underline" href="/register">Create one!</a></p>
    </main>
    <script src="/login.js" defer></script>
  </body>
</html>